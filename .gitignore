# Deny by default. Only approved source and synthetic fixtures are eligible.
/*
!/.gitignore
!/README.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/scripts/
/scripts/*
!/scripts/verify-instagram.ts
!/scripts/verify-instagram-side-tables.ts
!/scripts/import-instagram.ts
!/scripts/explore-instagram.ts
!/scripts/analyze-instagram.ts
!/scripts/build-report.ts
!/scripts/propose-folder-split.ts
!/scripts/audit-hashtags.ts
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/test.yml
!/docs/
/docs/*
!/docs/*.md
!/packages/
/packages/*
!/packages/core/
/packages/core/*
!/packages/core/package.json
!/packages/core/src/
!/packages/core/tests/
!/packages/security/
!/packages/report/
!/packages/cli/
!/packages/mcp-server/
/packages/security/*
/packages/report/*
/packages/cli/*
/packages/mcp-server/*
!/packages/security/README.md
!/packages/report/README.md
!/packages/report/report.js
!/packages/report/report.css
!/packages/report/annotations.js
!/packages/cli/README.md
!/packages/mcp-server/README.md
/packages/core/src/**
!/packages/core/src/**/
!/packages/core/src/**/*.ts
/packages/core/tests/**
!/packages/core/tests/**/
!/packages/core/tests/**/*.test.ts
!/packages/core/tests/fixtures/
/packages/core/tests/fixtures/*
!/packages/core/tests/fixtures/README.md
!/packages/core/tests/fixtures/instagram.synthetic.json
# Defense in depth, including otherwise allowed directories.
**/node_modules/
**/.env*
**/data/
**/Instagram/
**/dist/
**/coverage/
**/*.zip
**/*.csv
**/*.jsonl
**/*.log
**/*.db
**/*.sqlite*
